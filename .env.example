PORT=4000

# Comma-separated list of allowed origins. Required: main.ts reads it with
# getOrThrow, and the app will not finish starting without it.
CORS_ORIGIN=http://localhost:3010

JWT_SECRET='SECRET'
JWT_EXPIRATION='EXPIRATION_TIME'

# Postgres connection strings. DATABASE_URL is what the app connects with,
# DIRECT_URL is what prisma migrate uses. Both need real values before the
# app can start.
DATABASE_URL='DB_URL'
DIRECT_URL='POSTGRESS_URL'

# Optional pg pool tuning for PrismaService (src/prisma/prisma.service.ts).
# Sane defaults are baked in (max 20, 30s idle timeout, 10s connection
# timeout) so these only need setting to override them for a given deploy.
# DATABASE_POOL_MAX=20
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

SUPABASE_URL=http://localhost
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key

STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
# Legacy single price, still used by older checkout paths.
STRIPE_PRICE_ID=price_mock
# Per-tier prices. Both are required: without them every tier would quietly
# bill at the same amount, which is harder to notice than a failure to start.
STRIPE_PRICE_ID_BASIC=price_mock_basic
STRIPE_PRICE_ID_PRO=price_mock_pro

# Public base URL of this API. Must be a valid URI.
APP_URL=http://localhost:4000

# Resend API key, used for every transactional email. Required.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
ONBOARDING_EMAIL=onboarding@your-domain.com
NOTIFICATION_EMAIL=notifications@your-domain.com

# PostHog (optional). Leave POSTHOG_API_KEY empty to disable analytics
# locally. POSTHOG_HOST must be a valid URI when set: use
# https://us.i.posthog.com, https://eu.i.posthog.com, or your own host.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Coach feature: AES-256-GCM master key for encrypting user BYOK keys at rest.
# Must be base64 that decodes to exactly 32 bytes.
# Generate a real one with: openssl rand -base64 32
# The value below is a throwaway placeholder so a fresh clone starts. Never
# use it anywhere real.
# PROD: must be a separate, securely stored secret in the deployment env.
BYOK_ENCRYPTION_KEY=ZGV2LW9ubHktbm90LWEtcmVhbC1rZXktMDAwMDAwMDA=

# Shared Gemini Flash fallback (optional).
# When set, users who have not added their own BYOK key can still chat
# with the Coach using this key, gated by a per-user daily message
# count (default 20, override with SHARED_COACH_DAILY_LIMIT). Get a
# free key at https://aistudio.google.com/apikey, no credit card.
# Leave empty to disable the shared fallback entirely (users will be
# required to add their own key before the Coach answers anything).
GOOGLE_AI_SHARED_API_KEY=
SHARED_COACH_DAILY_LIMIT=20

# jiffy-messaging (optional — user-to-user chat).
# Leave URL and secret empty to keep messaging switched off: the API boots
# normally and POST /api/messaging/* answers 503.
#
# JIFFY_MESSAGING_JWT_SECRET must be byte-identical to the messaging
# service's own JWT_SECRET, and the issuer/audience below must match its
# JWT_ISSUER / JWT_AUDIENCE, or every token we mint is rejected as invalid.
# Do NOT reuse the GoalSlot JWT_SECRET above: a leak of the messaging
# secret would otherwise mint GoalSlot session tokens too.
# Generate with: openssl rand -base64 48
JIFFY_MESSAGING_URL=
JIFFY_MESSAGING_JWT_SECRET=
# Defaults if unset: goalslot-api / jiffy-messaging / 900 / 5000
JIFFY_MESSAGING_JWT_ISSUER=goalslot-api
JIFFY_MESSAGING_JWT_AUDIENCE=jiffy-messaging
# Token lifetime in seconds. Clients re-POST /api/messaging/token to refresh.
JIFFY_MESSAGING_TOKEN_TTL=900
# Per-request timeout for server-to-server calls into the service.
JIFFY_MESSAGING_TIMEOUT_MS=5000

# Conversation gate callback (optional — closes the jiffy-messaging
# authorization bypass).
#
# jiffy-messaging's own POST /conversations has no idea what "allowed to
# message" means for GoalSlot — it only checks that the caller listed
# themselves as a participant. Without this secret configured, a user's
# self-service /api/messaging/token JWT could be used to call
# jiffy-messaging directly and open a conversation with anyone, skipping
# canMessage() entirely. Setting this turns on
# POST /internal/messaging/can-create-conversation, which jiffy-messaging
# calls back before creating a conversation and before every message send
# to re-run canMessage() — so a revoked share also stops a conversation
# from accepting new messages on the next attempt, not just at creation.
#
# This must be set on jiffy-messaging's side too, as CONVERSATION_GATE_URL
# (pointing at https://<this-api>/api/internal/messaging/can-create-conversation)
# and CONVERSATION_GATE_SECRET (byte-identical to the value below). Do NOT
# reuse JIFFY_MESSAGING_JWT_SECRET — this is a different credential for a
# different direction of call.
# Generate with: openssl rand -base64 48
CONVERSATION_GATE_SECRET=

# Message-notify callback (optional — new-message push/email notifications).
#
# jiffy-messaging has no notion of email or push notifications; it only
# knows a message was sent. Without this secret configured, sending a
# message never notifies the recipient beyond the WebSocket connection
# they already have open — no push, no email, and nothing if they are not
# actively looking at the app. Setting this turns on
# POST /internal/messaging/on-message-sent, which jiffy-messaging calls
# after every message send, and this API dispatches a notification to
# each recipient through ReminderDispatchService — the same push/email
# infrastructure instruction assignments and stale-report reminders use.
#
# This must be set on jiffy-messaging's side too, as MESSAGE_NOTIFY_URL
# (pointing at https://<this-api>/api/internal/messaging/on-message-sent)
# and MESSAGE_NOTIFY_SECRET (byte-identical to the value below). Do NOT
# reuse CONVERSATION_GATE_SECRET or JIFFY_MESSAGING_JWT_SECRET — this is a
# different credential for a different direction of call.
# Generate with: openssl rand -base64 48
MESSAGE_NOTIFY_SECRET=

# Web push VAPID keys (optional — browser push notifications).
# Leave all three empty to keep the web-push reminder channel switched
# off: it degrades to a no-op sender rather than failing anything. All
# three travel together — set one and the other two are required.
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https URL identifying who to contact about this
# application's use of the push service, per the VAPID spec.
VAPID_SUBJECT=
INTEGRATION_STATE_SECRET=

# Notion Integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/api/integrations/notion/callback


# --- Google sign-in (optional) ---
# Leave blank to keep Google sign-in switched off: the API boots normally and
# GET /api/auth/google + /api/auth/google/callback return 404. Set the id and
# secret together to enable it.
#
# Create these at https://console.cloud.google.com/apis/credentials as an
# "OAuth client ID" of type "Web application", and register this exact
# Authorized redirect URI on it:
#   https://api.goalslot.io/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED when the two above are set, and must point at the API host - not
# APP_URL, which is the web app. Must match the redirect URI registered on the
# OAuth client byte for byte.
GOOGLE_CALLBACK_URL=https://api.goalslot.io/api/auth/google/callback
# Where the callback redirects the browser afterwards. Defaults to APP_URL.
FRONTEND_URL=https://www.goalslot.io

# --- Google Calendar import (optional) ---
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above: one OAuth client, one
# consent screen, two redirect URIs. Only the redirect URI below is new.
#
# Leave it blank to keep calendar import switched off - the API boots normally
# and /api/integrations/google-calendar/* returns 404.
#
# To switch it on, in the same Google Cloud project as the sign-in client:
#   1. Enable the Google Calendar API
#      (https://console.cloud.google.com/apis/library/calendar-json.googleapis.com)
#   2. Add .../auth/calendar.readonly to the OAuth consent screen's scopes.
#      readonly is a "sensitive" scope; the read-write .../auth/calendar is
#      "restricted" and needs a security assessment we do not need to pass,
#      since this feature only ever reads.
#   3. Add the URI below as a second Authorized redirect URI on the SAME
#      OAuth client used for sign-in. It must match byte for byte.
GOOGLE_CALENDAR_REDIRECT_URI=https://api.goalslot.io/api/integrations/google-calendar/callback

# --- CLI authentication (optional) ---
# Every value below has a working default, so the API boots and `goalslot login`
# works with all four unset. They exist for tuning, not for enabling anything.
#   CLI_ACCESS_TOKEN_TTL             default 1h   - CLI access token lifetime
#   CLI_REFRESH_TOKEN_DAYS           default 90   - sliding refresh window
#   CLI_REFRESH_TOKEN_ABSOLUTE_DAYS  default 365  - hard ceiling, never extended
#   CLI_SESSION_TTL_SECONDS          default 600  - how long an approval stays open
CLI_ACCESS_TOKEN_TTL=
CLI_REFRESH_TOKEN_DAYS=
CLI_REFRESH_TOKEN_ABSOLUTE_DAYS=
CLI_SESSION_TTL_SECONDS=
